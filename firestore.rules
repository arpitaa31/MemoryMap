rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function anonymousUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function registeredUser() {
      return signedIn() && !anonymousUser();
    }

    function mapPath(memoryMapId) {
      return /databases/$(database)/documents/memoryMaps/$(memoryMapId);
    }

    function memberPath(memoryMapId, userId) {
      return /databases/$(database)/documents/memoryMaps/$(memoryMapId)/members/$(userId);
    }

    function isExistingOwner(memoryMapId) {
      return signedIn()
        && get(mapPath(memoryMapId)).data.ownerId == request.auth.uid;
    }

    function isActiveMember(memoryMapId) {
      return signedIn() && (isExistingOwner(memoryMapId) || get(memberPath(memoryMapId, request.auth.uid)).data.status == "active");
    }

    function hasActiveInvite(code) {
      return code is string && get(/databases/$(database)/documents/inviteCodes/$(code)).data.active == true;
    }

    function guestCoverUpdateAllowed() {
      return !anonymousUser()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "coverImageUrl", "coverImageStorageId", "coverImagePosition", "coverImageUpdatedAt"
        ]);
    }

    match /memoryMaps/{memoryMapId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && ((anonymousUser() && request.resource.data.ownerType == "guest")
          || (registeredUser() && request.resource.data.ownerType == "registered"));

      allow get: if isActiveMember(memoryMapId);
      // Firestore evaluates this against each candidate document. The client
      // must constrain the query with where("ownerId", "==", request.auth.uid).
      allow list: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if (isExistingOwner(memoryMapId) && request.resource.data.ownerId == request.auth.uid
          && (!anonymousUser() || (request.resource.data.ownerType == "guest" && guestCoverUpdateAllowed())))
        || (isActiveMember(memoryMapId)
          && (
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberCount", "updatedAt"])
              && request.resource.data.memberCount == resource.data.memberCount + 1)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memoryCount", "updatedAt"])
              && (request.resource.data.memoryCount == resource.data.memoryCount + 1 || request.resource.data.memoryCount == resource.data.memoryCount - 1))
          ))
        // A new member and the member counter are written in one batch by the
        // join flow. The new member is not visible to isActiveMember() until
        // after the batch commits, so use getAfter() for this one update.
        || (registeredUser()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberCount", "updatedAt"])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && getAfter(memberPath(memoryMapId, request.auth.uid)).data.userId == request.auth.uid
          && getAfter(memberPath(memoryMapId, request.auth.uid)).data.role == "member"
          && getAfter(memberPath(memoryMapId, request.auth.uid)).data.status == "active"
          && hasActiveInvite(getAfter(memberPath(memoryMapId, request.auth.uid)).data.inviteCode));
      allow delete: if isExistingOwner(memoryMapId);

      match /members/{userId} {
        allow create: if (signedIn()
            && userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.role == "owner"
            && request.resource.data.status == "active"
            && get(mapPath(memoryMapId)).data.ownerId == request.auth.uid)
          || (registeredUser() && userId == request.auth.uid && request.resource.data.userId == request.auth.uid && request.resource.data.role == "member" && request.resource.data.status == "active" && hasActiveInvite(request.resource.data.inviteCode));

        // A prospective member may check their own membership before joining.
        // This does not expose another member's data and avoids turning a
        // legitimate duplicate-membership check into permission-denied.
        allow read: if isActiveMember(memoryMapId)
          || (signedIn() && userId == request.auth.uid);
        allow update, delete: if isExistingOwner(memoryMapId);
      }

      match /floors/{floorId} {
        allow create: if signedIn()
          && get(mapPath(memoryMapId)).data.ownerId == request.auth.uid;

        allow read: if isActiveMember(memoryMapId);
        allow update, delete: if isExistingOwner(memoryMapId);

        match /rooms/{roomId} {
          allow read: if isActiveMember(memoryMapId);
          allow create, update, delete: if isExistingOwner(memoryMapId);
        }

        match /corridors/{corridorId} {
          allow read: if isActiveMember(memoryMapId);
          allow create, update, delete: if isExistingOwner(memoryMapId);
        }
      }

      match /memories/{memoryId} {
        allow read: if isActiveMember(memoryMapId);
        allow create: if isActiveMember(memoryMapId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.type in ["incident", "image"]
          && (!anonymousUser() || request.resource.data.type == "incident");
        allow update, delete: if isExistingOwner(memoryMapId) || (signedIn() && resource.data.createdBy == request.auth.uid);
      }
    }

    match /inviteCodes/{inviteCode} {
      allow create: if registeredUser()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(mapPath(request.resource.data.memoryMapId)).data.ownerId == request.auth.uid
        && getAfter(mapPath(request.resource.data.memoryMapId)).data.ownerType != "guest";

      // Invite pages may read only the document whose ID is in the URL after
      // Firebase Auth has resolved. Collection enumeration stays disabled.
      allow get: if request.auth != null;
      allow list: if false;

      allow update, delete: if registeredUser()
        && get(mapPath(resource.data.memoryMapId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId}/memoryMaps/{memoryMapId} {
      allow read, create, update, delete: if signedIn()
        && request.auth.uid == userId;
    }
  }
}
